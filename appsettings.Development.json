{
  "Dns": {
    "Listen": {
      "Address": "127.0.0.1",
      "Port": 1053
    },
    "DefaultResolver": {
      "Name": "Cloudflare",
      "Address": "1.1.1.1",
      "Port": 53
    },
    "Resolvers": [
      {
        "Name": "LocalDNS",
        "Address": "127.0.0.1",
        "Port": 5353,
        "Rule": "^localdev\\.",
        "Block": false
      },
      {
        "Name": "BlockDevAds",
        "Rule": "^(ads|tracking)\\.",
        "Block": true
      }
    ],
    "HostsFiles": [],
    "Caching": {
      "Enabled": true,
      "TtlSeconds": 300,
      "MaxEntries": 2000
    },
    "BlockResponse": {
      "Mode": "NXDOMAIN",
      "StaticIp": "0.0.0.0",
      "Ttl": 60
    }
  },
  "Dhcp": {
    "Enabled": false,
    "ListenAddress": "127.0.0.1",
    "ListenPort": 1067,
    "LeaseStorePath": "leases.json",
    "PoolCidr": "192.168.10.0/24",

    "ServerIdentifier": "192.168.10.1",
    "Router": "192.168.10.1",
    "DnsServer": "1.1.1.1",

    "LeaseHours": 1,

    "ArpTimeoutMs": 500,

    "BadIpStorePath": "badips.json"
  },
  "Logging": {
    "Level": "Debug"
  }
}

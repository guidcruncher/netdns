{
  "Listen": {
    "Address": "127.0.0.1",
    "Port": 1053
  },

  "DefaultResolver": {
    "Name": "Cloudflare",
    "Address": "1.1.1.1",
    "Port": 53
  },

  "Resolvers": [
    {
      "Name": "LocalDNS",
      "Address": "127.0.0.1",
      "Port": 5353,
      "Rule": "^localdev\\.",
      "Block": false
    },
    {
      "Name": "BlockDevAds",
      "Rule": "^(ads|tracking)\\.",
      "Block": true
    }
  ],

  "HostsFiles": [
  ],

  "Caching": {
    "Enabled": true,
    "TtlSeconds": 300,
    "MaxEntries": 2000
  },

  "BlockResponse": {
    "Mode": "NXDOMAIN",     // NXDOMAIN | SERVFAIL | REFUSED | STATIC_IP
    "StaticIp": "0.0.0.0",  // used only when Mode = STATIC_IP 
    "Ttl": 60               // optional TTL override
  },

  "Logging": {
    "Level": "Debug"
  }
}

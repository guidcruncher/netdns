{
  "Listen": {
    "Address": "0.0.0.0",
    "Port": 53
  },

  "DefaultResolver": {
    "Name": "Cloudflare",
    "Address": "1.1.1.1",
    "Port": 53
  },

  "Resolvers": [
    {
      "Name": "DockerInternal",
      "Address": "127.0.0.11",
      "Port": 53,
      "Rule": "^docker\\.",
      "Block": false
    },
    {
      "Name": "BlockAds",
      "Rule": "^(ads|tracking|metrics)\\.",
      "Block": true
    }
  ],

  "HostsFiles": [
  ],

  "Caching": {
    "Enabled": true,
    "TtlSeconds": 300,
    "MaxEntries": 10000
  },

  "BlockResponse": {
    "Mode": "NXDOMAIN",     // NXDOMAIN | SERVFAIL | REFUSED | STATIC_IP
    "StaticIp": "0.0.0.0",  // used only when Mode = STATIC_IP
    "Ttl": 60               // optional TTL override
  },

  "Logging": {
    "Level": "Warning"
  }
}

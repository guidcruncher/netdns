{
  "Listen": {
    "Address": "0.0.0.0",
    "Port": 53
  },

  "DefaultResolver": {
    "Name": "Cloudflare",
    "Address": "1.1.1.1",
    "Port": 53
  },

  "Resolvers": [
    {
      "Name": "DockerInternal",
      "Address": "127.0.0.11",
      "Port": 53,
      "Rule": "^docker\\.",
      "Block": false
    },
    {
      "Name": "BlockAds",
      "Rule": "^(ads|tracking|metrics)\\.",
      "Block": true
    }
  ],

  "HostsFiles": [
  ],

  "Caching": {
    "Enabled": true,
    "TtlSeconds": 300,
    "MaxEntries": 10000
  },

  "Logging": {
    "Level": "Warning"
  }
}

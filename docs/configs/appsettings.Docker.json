{
  "Service": {
    "DnsPort": 1053,
    "AlternateDnsPort": 1053,
    "EnableDhcp": false,
    "Dhcp": {
      "ListenPort": 67,
      "PoolCidr": "192.168.100.0/24",
      "LeaseSeconds": 3600,
      "Gateway": "192.168.100.1",
      "Dns": ["192.168.100.1"]
    },
    "EnableNtp": false,
    "Ntp": {
      "ListenPort": 123
    }
  },

  "Resolvers": [
    {
      "Name": "Cloudflare",
      "Address": "1.1.1.1",
      "Port": 53,
      "Block": false
    }
  ],

  "DefaultResolvers": [
    {
      "Name": "Cloudflare",
      "Address": "1.1.1.1",
      "Port": 53,
      "Block": false
    }
  ],

  "Caching": {
    "Enabled": true,
    "TtlSeconds": 300,
    "MaxEntries": 10000
  },

  "BlocklistSources": {
    "Files": [
      "/app/blocklists/blocklist.txt"
    ],
    "Urls": []
  },

  "Hosts": [],

  "Metrics": {
    "HttpPort": 1080,
    "MetricsPath": "/metrics"
  },

  "Logging": {
    "LogLevel": "Information",
    "Structured": true
  },

  "Blocklist": {
    "AdGuardCompatibility": true,
    "CacheTtlHours": 24
  },

  "Diagnostics": {
    "EnableHealthEndpoint": true,
    "HealthPort": 1081
  }
}

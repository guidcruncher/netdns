{
  "Service": {
    "DnsPort": 53,
    "AlternateDnsPort": 1053,
    "EnableDhcp": false,
    "Dhcp": {
      "ListenPort": 67,
      "PoolCidr": "192.168.10.0/24",
      "LeaseSeconds": 3600,
      "Gateway": "192.168.10.1",
      "Dns": ["192.168.10.1"]
    },
    "EnableNtp": false,
    "Ntp": {
      "ListenPort": 123
    }
  },

  "Resolvers": [
    {
      "Name": "Cloudflare",
      "Address": "1.1.1.1",
      "Port": 53,
      "Block": false
    },
    {
      "Name": "BlockAds",
      "Rule": "^(ads|tracking)\\.",
      "Block": true
    }
  ],

  "DefaultResolvers": [
    {
      "Name": "Cloudflare",
      "Address": "1.1.1.1",
      "Port": 53,
      "Block": false
    },
    {
      "Name": "Google",
      "Address": "8.8.8.8",
      "Port": 53,
      "Block": false
    }
  ],

  "Caching": {
    "Enabled": true,
    "TtlSeconds": 300,
    "MaxEntries": 10000
  },

  "BlocklistSources": {
    "Files": [
      "./blocklists/blocklist.txt"
    ],
    "Urls": [
      "https://example.com/blocklist.txt"
    ]
  },

  "Hosts": [
    {
      "Pattern": "*.example.com",
      "Address": "10.0.0.5"
    },
    {
      "Pattern": "nas.local",
      "Address": "192.168.1.10"
    }
  ],

  "Metrics": {
    "HttpPort": 1080,
    "MetricsPath": "/metrics"
  },

  "Logging": {
    "LogLevel": "Information",
    "Structured": true
  },

  "Blocklist": {
    "AdGuardCompatibility": true,
    "CacheTtlHours": 24
  },

  "Diagnostics": {
    "EnableHealthEndpoint": true,
    "HealthPort": 1081
  }
}
